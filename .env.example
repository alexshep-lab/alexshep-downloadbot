# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Кому разрешено пользоваться ботом: Telegram user id через запятую.
# Если оба списка доступа пусты, бот не запустится. Свой id можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# Разрешённые группы/чаты: chat id через запятую (у групп id отрицательный).
# Узнать id — команда /id в нужном чате.
ALLOWED_CHAT_IDS=

# Путь к cookies.txt (формат Netscape). Нужен, если Instagram требует логин
# или YouTube пишет "Sign in to confirm you're not a bot". См. README.
COOKIES_FILE=

# Для каких сервисов подставлять cookies: ig, yt, tt, x через запятую либо all.
# Instagram даже при ig/all всегда сначала пробуется без аккаунта;
# cookies разрешены только как запасной вариант. После checkpoint сессия отключается.
COOKIES_SERVICES=ig

# Этим сервисам cookies подставляются только со второй попытки — когда первая,
# анонимная, упёрлась в «нужен вход» (бот-проверка, возрастное ограничение).
# Так аккаунт светится лишь там, где без него никак.
COOKIES_FALLBACK_SERVICES=yt

# Прокси для скачивания, например http://127.0.0.1:8080 или socks5://...
PROXY=

# Куда складывать временные файлы (по умолчанию — папка temp системы)
DOWNLOAD_DIR=

# Локальный Bot API server: лимит файла 2 ГБ вместо 50 МБ.
# Пусто = облачный api.telegram.org
TELEGRAM_API_URL=

# Максимальный размер файла, МБ (50 для облачного API, до 2000 для локального)
MAX_FILE_SIZE_MB=

# Максимальное качество для коротких видео
MAX_HEIGHT=1080

# Качество для длинных и тяжёлых видео (в 1080p смысла мало)
PREFERRED_HEIGHT=720

# Когда считать видео "тяжёлым"/"длинным" и качать в PREFERRED_HEIGHT
HD_MAX_SIZE_MB=100
HD_MAX_DURATION_MIN=20

# Как часто обновлять статус скачивания в чате, сек (меньше 3 — Telegram заругается)
PROGRESS_INTERVAL=5

# Порог "соединение придушили", КБ/с: ниже — берём свежую ссылку и продолжаем.
# YouTube душит долгие соединения, без этого скорость сползает в сотни КБ/с.
THROTTLE_FLOOR_KB=500

# Поймали 429 (слишком много запросов) — на столько минут перестаём дёргать сервис.
# Повторы во время блокировки только продлевают её.
RATE_LIMIT_COOLDOWN_MIN=30

# В группах сообщения об ошибках самоудаляются через столько секунд (0 = висят всегда)
ERROR_TTL_SEC=60

# Где хранить file_id уже отправленных видео (повторная ссылка уходит мгновенно)
CACHE_FILE=

# Таймаут скачивания одного видео, секунд
DOWNLOAD_TIMEOUT=900

# Таймаут отправки файла в Telegram, секунд (увеличь, если аплоад медленный)
UPLOAD_TIMEOUT=600

# Сколько видео качать одновременно
MAX_CONCURRENT_DOWNLOADS=2

# Сколько запросов всего может выполняться или ждать очереди
MAX_PENDING_REQUESTS=12

# Сколько запросов одновременно может поставить один пользователь
MAX_REQUESTS_PER_USER=3

# Максимальное число записей в кеше Telegram file_id
MAX_CACHE_ENTRIES=5000

# Перекодировать для iPhone (VP9/AV1/10 бит → H.264) видео не длиннее стольких минут
TRANSCODE_MAX_DURATION_MIN=5

# Как часто проверять, что сессия Instagram в cookies жива, минут (пишет владельцу в личку)
IG_SESSION_CHECK_MIN=60

# @ник автора, у которого новые люди и группы просят доступ (без @)
OWNER_USERNAME=AlexShep
